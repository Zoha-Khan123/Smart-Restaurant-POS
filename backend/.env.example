# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/restaurant_pos

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_characters_long_example
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters_long_example
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Configuration (CORS)
FRONTEND_URL=http://localhost:3000

# Email / Nodemailer Configuration
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_FROM="Smart Restaurant POS <no-reply@restaurantpos.local>"

# Super Admin Provisioning (Seed)
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=superadmin@restaurantpos.com
SUPER_ADMIN_PASSWORD=SuperAdmin@SecurePass123!
